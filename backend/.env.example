# Copy to backend/.env and edit. Every value has a working default.

# ---- app -----------------------------------------------------------------
ENV=dev
API_PREFIX=/api/v1
# JSON array (pydantic-settings parses complex types as JSON)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ---- storage -------------------------------------------------------------
STORAGE_DIR=storage
DATABASE_URL=sqlite:///./lightnote.db

# ---- queue ---------------------------------------------------------------
# thread = no broker needed (local dev, Windows). celery = real worker process.
QUEUE_MODE=thread
REDIS_URL=redis://localhost:6379/0
THREAD_WORKERS=2

# ---- ingest limits -------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_DURATION_S=180

# ---- processing ----------------------------------------------------------
PROXY_MAX_DIM=720
SAMPLE_FPS=3.0
REMOVAL_METHOD=auto
JOB_TIME_BUDGET_S=900

# ---- AI ------------------------------------------------------------------
# AI_ENABLED=false makes the pipeline fall back to pure computer vision.
AI_ENABLED=true
VLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
WHISPER_MODEL=base
