# ---- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage*

# ---- application data ------------------------------------------------------
# Per-job workspaces: source video, proxy, frames, clips, clean plate.
# Regenerated by running a job; never committed.
storage/
# SQLite database and its write-ahead log.
*.db
*.db-wal
*.db-shm

# Real configuration, including API keys. `.env.example` is committed instead;
# a bare rule like this matches at any depth.
.env
.env.local
.env.*.local

# ---- node / frontend -------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# ---- editors / os ----------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- scratch ---------------------------------------------------------------
*.log
tmp/
scratch/
